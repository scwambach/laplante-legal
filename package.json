{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dev": "next dev",
    "dev:test": "concurrently \"next dev\" \"npm run test:watch\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "prepare": "husky install",
    "check-format": "prettier --write .",
    "check-lint": "eslint . --ext ts --ext tsx --ext js",
    "ncu": "ncu",
    "ncu:update": "ncu -u"
  },
  "engines": {
    "node": ">=20.11.0",
    "yarn": "please-use-npm"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "glob": "^11.0.0",
    "minimatch": "^10.0.0",
    "tar": "^7.5.11",
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@portabletext/react": "^3.2.4",
    "@react-google-maps/api": "^2.20.8",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^3.99.0",
    "@types/node": "20.14.8",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dayjs": "^1.11.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.4",
    "markdown-it": "^14.1.1",
    "next": "^14.2.35",
    "next-sanity": "^9.12.3",
    "nodemailer": "^8.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-paginate": "^8.3.0",
    "react-player": "^2.16.1",
    "react-select": "^5.10.2",
    "sanity": "^3.99.0",
    "sanity-plugin-iframe-pane": "^3.2.2",
    "sanity-plugin-media": "^2.4.2",
    "styled-components": "^6.4.1",
    "typescript": "5.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.12",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "18.3.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "chromatic": "^11.29.0",
    "concurrently": "^8.2.2",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.7.0",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "npm-check-updates": "^16.14.20",
    "prettier": "^3.8.3",
    "sass": "^1.99.0"
  }
}
